# Copy to .env (gitignored) or export this directly in your shell before
# running `npm run build`. This project has no dependencies, so nothing here
# auto-loads a .env file — export the variable yourself, e.g.:
#
#   export GIPHY_API_KEY=your-key-here
#   npm run build
#
# Giphy issues one API key per app (https://developers.giphy.com/dashboard/),
# not per user, so this is the maintainer's key, injected into background.js
# at build time. It is never committed — see src/background.js and
# scripts/build.mjs for how the placeholder gets replaced. Building without
# this set produces a working extension with GIF search disabled.

GIPHY_API_KEY=

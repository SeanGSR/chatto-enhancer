{
  "manifest_version": 3,
  "name": "Chatto Enhancer",
  "version": "1.2",
  "description": "Themes, per-person volume sliders, emoji, GIFs, markdown controls, and more for Chatto.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "storage",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "https://api.giphy.com/*",
    "https://*.giphy.com/*"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    },
    "default_title": "Chatto Enhancer settings"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "chatto-enhancer@local.extension",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  },
  "web_accessible_resources": [
    {
      "resources": [
        "main-world.js"
      ],
      "matches": [
        "https://chat.chatto.run/*"
      ]
    }
  ],
  "content_scripts": [
    {
      "matches": [
        "https://chat.chatto.run/*"
      ],
      "js": [
        "main-world.js"
      ],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": false
    },
    {
      "matches": [
        "https://chat.chatto.run/*"
      ],
      "js": [
        "theme-data.js",
        "emoji-data.js",
        "content/index.js"
      ],
      "css": [
        "styles.css"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}

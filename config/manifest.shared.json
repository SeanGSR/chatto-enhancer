{
  "manifest_version": 3,
  "name": "Chatto Enhancer",
  "version": "1.1",
  "description": "Per-person volume sliders in voice calls, an emoji picker, and markdown formatting in the message box.",
  "permissions": [
    "storage",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "https://api.giphy.com/*",
    "https://*.giphy.com/*"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Chatto Enhancer settings"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "chatto-enhancer@local.extension",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  },
  "web_accessible_resources": [
    {
      "resources": [
        "main-world.js"
      ],
      "matches": [
        "https://chat.chatto.run/*",
        "https://chatto.pixel-box.net/*"
      ]
    }
  ],
  "content_scripts": [
    {
      "matches": [
        "https://chat.chatto.run/*",
        "https://chatto.pixel-box.net/*"
      ],
      "js": [
        "main-world.js"
      ],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": false
    },
    {
      "matches": [
        "https://chat.chatto.run/*",
        "https://chatto.pixel-box.net/*"
      ],
      "js": [
        "emoji-data.js",
        "content/index.js"
      ],
      "css": [
        "styles.css"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
